{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081"
  },
  "version": "v1.0.0",
  "id": "clv.extreme-optimizer",
  "name": "Extreme Optimizer",
  "developer": "clv",
  "description": "Disables everything heavy and laggy (glow, particles, trails, effects) on phone and PC without touching physics.",
  "settings": {
    "only-in-level": {
      "type": "bool",
      "name": "Only Inside Levels",
      "default": true
    },
    "disable-block-glow": {
      "type": "bool",
      "name": "Disable Block Glow",
      "default": true
    },
    "disable-spike-glow": {
      "type": "bool",
      "name": "Disable Spike Glow",
      "default": true
    },
    "disable-all-glow": {
      "type": "bool",
      "name": "Disable All Object Glow",
      "default": true
    },
    "disable-particles": {
      "type": "bool",
      "name": "Disable Particles",
      "default": true
    },
    "particle-amount": {
      "type": "int",
      "name": "Particle Amount (%)",
      "description": "Used when particles are not fully disabled.",
      "default": 0,
      "min": 0,
      "max": 100,
      "control": { "slider": true }
    },
    "disable-shake": {
      "type": "bool",
      "name": "Disable Camera Shake",
      "default": true
    },
    "disable-death-effect": {
      "type": "bool",
      "name": "Disable Death Effect",
      "default": true
    },
    "disable-wave-trail": {
      "type": "bool",
      "name": "Disable Wave Trail",
      "default": true
    },
    "disable-streak": {
      "type": "bool",
      "name": "Disable Motion Streak / Trail",
      "default": true
    },
    "hide-background": {
      "type": "bool",
      "name": "Hide Background",
      "default": true
    },
    "hide-ground": {
      "type": "bool",
      "name": "Hide Ground",
      "default": false
    },
    "hide-decoration": {
      "type": "bool",
      "name": "Hide Decoration Objects",
      "description": "Hides objects without hitbox. Changes how the level looks.",
      "default": false
    }
  }
}
